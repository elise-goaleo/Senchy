# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# `.env.local` est ignoré par git (ne jamais committer de secrets).

# ─── Base de données (Prisma Postgres via Accelerate) ───────────────────────
# Runtime de l'app — connexion HTTP Accelerate.
# Généré dans la console Prisma : Accelerate → "Generate connection string".
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# Connexion DIRECTE à la même base — utilisée UNIQUEMENT en local par les
# migrations (`npm run db:push`) et Prisma Studio (`npm run db:studio`).
# Non nécessaire pour simplement lancer l'app (`npm run dev`).
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Générer un secret : openssl rand -base64 32
NEXTAUTH_SECRET="..."
# En local :
NEXTAUTH_URL="http://localhost:3000"

# ─── Email SMTP (optionnel — récupération de mot de passe) ──────────────────
# Sans ces variables, le lien de réinitialisation s'affiche dans les logs serveur.
# Gmail : SMTP_USER = votre adresse, SMTP_PASS = un mot de passe d'application.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Senchy <no-reply@exemple.com>"
